# App
APP_NAME=Snape API
APP_VERSION=0.1.0
DEBUG=true
API_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000

# Database (PostgreSQL with pgvector)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/snape

# Redis (for BullMQ)
REDIS_URL=redis://localhost:6379/0

# Auth (Clerk)
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_WEBHOOK_SECRET=

# Search APIs (Free tiers)
TAVILY_API_KEY=
CONTEXT_API_KEY=
FIRECRAWL_API_KEY=
EXA_API_KEY=

# LLM
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEFAULT_LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.1

# Email (Resend)
RESEND_API_KEY=
FROM_EMAIL=noreply@snape.ai

# Frontend
FRONTEND_URL=http://localhost:3000

# Job Queue
JOB_CONCURRENCY=3
JOB_TIMEOUT_SECONDS=600
JOB_MAX_RETRIES=2

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# Vector DB
VECTOR_DIMENSIONS=1536